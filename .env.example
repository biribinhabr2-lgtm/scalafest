# ─────────────────────────────────────────────────────────────
#  EscalaFest — WhatsApp Server — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais.
# ─────────────────────────────────────────────────────────────

# Porta HTTP do servidor (padrão: 3001)
PORT=3001

# URL do seu projeto Supabase
SUPABASE_URL=https://ybnqjvucyutpdjfpkgzg.supabase.co

# CHAVE DE SERVIÇO do Supabase (NÃO a chave pública/publishable)
# Acesse: Supabase Dashboard → Project Settings → API → service_role
# ATENÇÃO: nunca commite este arquivo com a chave real!
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui

# Segredo para validar chamadas do Dashboard (qualquer string aleatória)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=troque_por_uma_string_secreta_aleatoria

# Origem permitida para CORS (URL do seu Dashboard no Netlify ou localhost)
ALLOWED_ORIGIN=https://escalafest.netlify.app
